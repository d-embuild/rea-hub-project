# ── Server ──
NODE_ENV=production
PORT=8080
CORS_ORIGINS=https://admin.example.com

# ── Database (server-side only; privileged role that bypasses RLS) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── Supabase ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__SERVER_ONLY__
SUPABASE_JWT_SECRET=__SERVER_ONLY__

# ── Anti-fraud signing (generate each: openssl rand -base64 48) ──
QR_HMAC_SECRET=__MIN_32_CHARS__
TAG_SIGNING_SECRET=__MIN_32_CHARS__

# ── PII protection ──
# AES-256 key, exactly 32 bytes base64:  openssl rand -base64 32
PII_ENCRYPTION_KEY=__BASE64_32_BYTES__
PII_HASH_KEY=__MIN_32_CHARS__

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rea-media
R2_PUBLIC_BASE_URL=https://media.example.com

# ── Maps (proxied through backend) ──
MAPBOX_SECRET_TOKEN=

# ── Firebase Cloud Messaging ──
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Admin MFA (Supabase TOTP, aal2). Keep true in production; false only for local dev ──
REQUIRE_ADMIN_MFA=true

# ── Encrypted backups (scripts/backup.sh) ──
BACKUP_PASSPHRASE=__LONG_RANDOM_PASSPHRASE__
BACKUP_DIR=/var/backups/rea
RETENTION_DAYS=14
